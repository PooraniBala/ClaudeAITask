# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/devpulse

# JWT signing secret — minimum 32 random characters
JWT_SECRET=your_jwt_secret_minimum_32_chars_replace_this

# Node environment
NODE_ENV=development

# GitHub Personal Access Token — used by the GitHub MCP server and all API routes
# Required scopes: repo, read:user, read:org
GITHUB_TOKEN=your_github_personal_access_token
