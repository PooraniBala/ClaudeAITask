# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/devpulse

# Auth
# Must be minimum 32 characters
JWT_SECRET=your_jwt_secret_minimum_32_chars_long

# GitHub MCP
# Required scopes: repo, read:user, read:org
GITHUB_TOKEN=your_github_personal_access_token

# CI only — set as GitHub Actions secrets, never in .env files
# GITHUB_TOKEN is auto-provided by GitHub Actions
